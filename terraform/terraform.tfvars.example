# Copy to terraform.tfvars and fill in your values.

aws_profile = "your-sso-profile"
aws_region  = "eu-west-1"

# Optional overrides (defaults shown):
# cluster_name               = "rke2-lab"
# control_instance_type      = "t3.medium"
# worker_instance_type       = "t3.medium"
# root_volume_size           = 20
# irsa_namespace             = "irsa-test"
# irsa_service_account_name  = "irsa-test"

# Vault evaluation (see docs/vault.md) - off by
# default, since it's independent of the base cluster/IRSA:
# enable_vault         = true
# vault_instance_type  = "t3.small"
